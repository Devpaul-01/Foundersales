# FounderSales / Clutch AI — Backend environment variables
#
# This file is generated to match what the code actually reads — see
# src/config/validateEnv.js for the required/optional split that gates
# startup, and docs/backend-takeover/AUDIT.md for context on why two of
# these variable names matter (SUPABASE_SERVICE_ROLE_KEY and
# FIREBASE_SERVICE_ACCOUNT previously had a stale/wrong name checked at
# startup, which meant a missing value wasn't caught until it caused a
# confusing runtime failure instead).
#
# Copy this file to .env and fill in real values. Required variables will
# cause the process to exit with a clear message at boot if missing.
# Optional variables degrade a specific feature gracefully if missing —
# the process still starts.

# ── REQUIRED ──────────────────────────────────────────────────────────────

# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase SERVICE ROLE key (not the anon key) — Project Settings > API.
# The backend uses this exclusively for all database access; it bypasses
# Row Level Security, so treat it as a secret with full data access.
SUPABASE_SERVICE_ROLE_KEY=

# Groq API key — required for all AI features (chat, coaching, practice
# sessions, onboarding generation, insights, etc.)
GROQ_API_KEY=

# Secret header value required to access Bull Board (/admin/jobs), the
# background-job monitoring dashboard. Generate a long random string —
# this is effectively a password.
ADMIN_SECRET=

# ── OPTIONAL — degrades gracefully if unset ─────────────────────────────

# Supabase anon key. Currently unused by any active code path (the
# non-admin Supabase client this would configure has no importers in the
# codebase as of this writing — see docs/backend-takeover/AUDIT.md) but
# still constructed at startup, so set it to avoid a startup warning.
SUPABASE_ANON_KEY=

# Redis connection URL, e.g. redis://localhost:6379 or
# rediss://default:token@host.upstash.io:6379 (TLS). Powers: workspace/
# profile caching, rate limiting, and all BullMQ background job queues
# (calendar prep, practice sessions, scheduled digests, etc.). Without
# this, the app still starts and serves API requests, but caching falls
# back to in-memory (per-instance, not shared across replicas) and
# background jobs do not run at all.
REDIS_URL=

# Exa Search API key — used for prospect/opportunity research. Falls back
# to Groq-only research (lower quality, no live web data) without this.
EXA_API_KEY=

# Firebase service account credentials, as a single-line JSON string
# (the full contents of a Firebase service account key file). Required
# for push notifications; without it, push notifications are silently
# disabled and everything else continues to work normally.
FIREBASE_SERVICE_ACCOUNT=

# Allowed CORS origin for your deployed frontend, e.g.
# https://app.yourdomain.com. localhost:5173 and localhost:3000 are
# always allowed regardless of this value (local dev).
FRONTEND_URL=

# ── OPTIONAL — no startup warning, used by specific features ───────────

PORT=3001
NODE_ENV=development

# Sentry error tracking. Fully optional — every Sentry call site no-ops if
# SENTRY_DSN is unset.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=

# Cloudinary — file/image upload storage (routes/upload.js).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Outbound email. EMAIL_PROVIDER selects the sender: "resend" (needs
# RESEND_API_KEY) or "smtp" (needs the SMTP_* vars below). If
# EMAIL_PROVIDER is unset entirely, emails are logged to the console only
# rather than actually sent — useful for local development.
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# NOT read by services/email.js (the shared EMAIL_PROVIDER-selected
# sender above) — this was wrong in an earlier version of this file,
# corrected during the full backend audit. jobs/emailDigestJob.js has its
# own, entirely separate nodemailer/Gmail transport that reads these two
# vars independently. Set these only if you want the weekly email digest
# specifically to send via Gmail; they have no effect on any other
# outbound email in the app. See docs/backend-takeover/IMPLEMENTATION_PLAN.md
# for a note on whether this split should eventually be consolidated.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Groq model overrides — all have working defaults in code; only set
# these to override which specific Groq model each tier of the app uses.
GROQ_MODEL=
GROQ_PRIMARY_MODEL=
GROQ_PRO_MODEL=
GROQ_FLASH_MODEL=

# Multi-provider AI fallback internals (services/multiProvider.js).
PERPLEXITY_MODEL=
OPENROUTER_APP_TITLE=
OPENROUTER_REFERER=
MULTIPROVIDER_REDIS_STATE_ENABLED=

# Optional webhook URL that receives a notification if a background job
# ends up in BullMQ's dead-letter state after exhausting retries.
DEAD_LETTER_WEBHOOK_URL=

# OAuth redirect target, if applicable to your auth flow.
OAUTH_REDIRECT_URL=

# Verbose debug logging toggle — check individual services for exactly
# what this gates.
DEBUG_MODE=
